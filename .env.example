# Copy to .env only when overriding the safe local defaults in compose.yaml.
# Never use these development credentials in staging or production.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

POSTGRES_DB=microcrd
POSTGRES_USER=microcrd
POSTGRES_PASSWORD=microcrd-local
DATABASE_URL=postgresql://microcrd:microcrd-local@db:5432/microcrd

RABBITMQ_DEFAULT_USER=microcrd
RABBITMQ_DEFAULT_PASS=microcrd-local
RABBITMQ_DEFAULT_VHOST=microcrd
CELERY_BROKER_URL=amqp://microcrd:microcrd-local@rabbitmq:5672/microcrd

WAREHOUSE_PII_ENCRYPTION_KEYS=local-only-pii-key-change-me,local-only-change-me
IMPORT_MAX_UPLOAD_BYTES=26214400
IMPORT_MAX_UNCOMPRESSED_BYTES=536870912
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Read-only natural-language assistant. The API key is used only by Django and
# must never be exposed through a NEXT_PUBLIC_* variable.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
ASSISTANT_MAX_OUTPUT_TOKENS=900

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
